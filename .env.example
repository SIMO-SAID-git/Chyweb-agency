# Public
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_URL=
# Supabase (https://supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # SERVER ONLY secret. Accepts the legacy service_role JWT or a new sb_secret_... key. Never NEXT_PUBLIC_.
# Email (Resend: https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="Chyweb <hello@your-verified-domain.com>"
ADMIN_EMAIL=                    # inquiry notifications go here (falls back to NEXT_PUBLIC_CONTACT_EMAIL)
# RESEND_API_URL=   (optional override, used for testing against a mock)

# Only for `npm run verify:supabase` (optional admin check). Put in your SHELL, not in a committed file:
# VERIFY_ADMIN_EMAIL=
# VERIFY_ADMIN_PASSWORD=
